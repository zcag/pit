[Unit]
Description=pit idea ranker
Documentation=https://pit.example.com file://%h/pit/pit
After=network.target

[Service]
ExecStart=%h/pit/pit --addr 127.0.0.1:8802 --db %h/pit/pit.db --seed
Environment=PIT_API_KEY=CHANGE_ME

# --- hosted connectors (Claude.ai / ChatGPT "Connect") -----------------------
# Leave the issuer/resource pair unset and /mcp stays API-key-only.
# The resource IS the OAuth audience and must be this endpoint's public URL.
Environment=PIT_OAUTH_ISSUER=https://your-app.authkit.app
Environment=PIT_MCP_RESOURCE=https://pit.example.com/mcp
# Single-user gate, fail-closed: only these identities pass, even though the
# AuthKit app would otherwise issue a token to anyone who can sign up.
#
# ⚠️ This AuthKit app issues sub="1" and NO email claim — sign-in is delegated to
# an external identity provider, and the sub is that provider's user id, not a WorkOS
# one. So the gate has to be the sub, and PIT_OAUTH_ALLOWED_EMAIL is useless
# here. another app on the same tenant carries ALLOWED_SUB=1 for the same reason; it
# looks like a placeholder and is not.
#
# For a different authorization server, connect once and read the real identity:
#   journalctl --user -u pit | grep 'first verified-token identity'
Environment=PIT_OAUTH_ALLOWED_EMAIL=
Environment=PIT_OAUTH_ALLOWED_SUB=1

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
